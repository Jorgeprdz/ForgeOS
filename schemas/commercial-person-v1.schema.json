{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-os.local/schemas/commercial-person-v1.schema.json",
  "title": "Forge Commercial Person V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractType",
    "schemaVersion",
    "personReference",
    "advisorId",
    "displayIdentity",
    "normalizedMatching",
    "lifecycleState",
    "privacyClassification",
    "evidenceReferences",
    "createdAt",
    "createdBy",
    "updatedAt",
    "version"
  ],
  "properties": {
    "contractType": { "const": "FORGE_COMMERCIAL_PERSON" },
    "schemaVersion": { "const": "1.0.0" },
    "personReference": { "$ref": "#/$defs/opaqueReference" },
    "advisorId": { "$ref": "#/$defs/opaqueReference" },
    "displayIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "preferredName": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "normalizedMatching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizedName"],
      "properties": {
        "normalizedName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "verifiedPhone": { "type": ["string", "null"], "maxLength": 40 },
        "verifiedEmail": { "type": ["string", "null"], "format": "email", "maxLength": 320 },
        "birthDate": { "type": ["string", "null"], "format": "date" }
      }
    },
    "lifecycleState": {
      "enum": ["CANDIDATE", "CONFIRMED", "DISPUTED", "ARCHIVED"]
    },
    "privacyClassification": {
      "enum": ["PRIVATE", "SENSITIVE", "RESTRICTED"]
    },
    "evidenceReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/opaqueReference" },
      "uniqueItems": true
    },
    "createdAt": { "$ref": "#/$defs/isoDateTime" },
    "createdBy": { "$ref": "#/$defs/opaqueReference" },
    "updatedAt": { "$ref": "#/$defs/isoDateTime" },
    "version": { "type": "integer", "minimum": 1 },
    "archivedAt": { "type": ["string", "null"], "format": "date-time" },
    "archivedBy": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
    "archiveReason": { "type": ["string", "null"], "maxLength": 500 }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycleState": { "const": "ARCHIVED" } } },
      "then": { "required": ["archivedAt", "archivedBy", "archiveReason"] }
    }
  ],
  "$defs": {
    "opaqueReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "isoDateTime": { "type": "string", "format": "date-time" }
  }
}
