{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-os.local/schemas/policy-v2-coverage.schema.json",
  "title": "Forge Canonical Policy Coverage V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractType",
    "schemaVersion",
    "policyCoverageReference",
    "advisorId",
    "policyReference",
    "policyVersionReference",
    "coverageKind",
    "sourceEvidenceReferences",
    "verificationState",
    "completenessState",
    "freshnessState",
    "conflictState",
    "currentVersion",
    "createdAt",
    "createdBy",
    "updatedAt"
  ],
  "properties": {
    "contractType": { "const": "FORGE_POLICY_COVERAGE" },
    "schemaVersion": { "const": "1.0.0" },
    "policyCoverageReference": { "$ref": "#/$defs/opaqueReference" },
    "advisorId": { "$ref": "#/$defs/opaqueReference" },
    "policyReference": { "$ref": "#/$defs/opaqueReference" },
    "policyVersionReference": { "$ref": "#/$defs/opaqueReference" },
    "productCoverageReference": { "anyOf": [{ "$ref": "#/$defs/opaqueReference" }, { "type": "null" }] },
    "coverageCode": { "type": ["string", "null"], "maxLength": 120 },
    "coverageLabel": { "type": ["string", "null"], "maxLength": 240 },
    "coverageKind": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
    "coverageState": { "type": ["string", "null"], "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
    "sumInsured": { "type": ["number", "null"], "minimum": 0 },
    "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "premiumAmount": { "type": ["number", "null"], "minimum": 0 },
    "premiumCurrency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "annexReference": { "anyOf": [{ "$ref": "#/$defs/opaqueReference" }, { "type": "null" }] },
    "riderReference": { "anyOf": [{ "$ref": "#/$defs/opaqueReference" }, { "type": "null" }] },
    "effectiveFrom": { "type": ["string", "null"], "format": "date-time" },
    "effectiveTo": { "type": ["string", "null"], "format": "date-time" },
    "coveragePeriodValue": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "coveragePeriodUnit": { "type": ["string", "null"], "maxLength": 40, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
    "paymentPeriodValue": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "paymentPeriodUnit": { "type": ["string", "null"], "maxLength": 40, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
    "sourceEvidenceReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaqueReference" }
    },
    "verificationState": { "enum": ["REVIEWED", "CONFIRMED", "DISPUTED", "UNVERIFIED"] },
    "completenessState": { "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] },
    "freshnessState": { "enum": ["CURRENT", "STALE", "UNKNOWN"] },
    "conflictState": { "enum": ["CLEAR", "CONFLICT", "UNRESOLVED"] },
    "currentVersion": { "type": "integer", "minimum": 1 },
    "previousCoverageVersionReference": { "anyOf": [{ "$ref": "#/$defs/opaqueReference" }, { "type": "null" }] },
    "correctionOf": { "anyOf": [{ "$ref": "#/$defs/opaqueReference" }, { "type": "null" }] },
    "createdAt": { "$ref": "#/$defs/isoDateTime" },
    "createdBy": { "$ref": "#/$defs/opaqueReference" },
    "updatedAt": { "$ref": "#/$defs/isoDateTime" },
    "archivedAt": { "type": ["string", "null"], "format": "date-time" },
    "archivedBy": { "type": ["string", "null"], "maxLength": 240 },
    "archiveReason": { "type": ["string", "null"], "maxLength": 500 }
  },
  "$defs": {
    "opaqueReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "isoDateTime": { "type": "string", "format": "date-time" }
  }
}
